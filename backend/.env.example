PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=SIGR
# Conexiones simultáneas con MySQL (4 a 200; por omisión 30). Con más usuarios a la vez, súbelo.
# DB_POOL_LIMIT=30
JWT_SECRET=cambia_esto_por_algo_largo
CORREO_PROVEEDOR=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=
# Opcional: orígenes del front permitidos por CORS (separados por coma)
# CORS_ORIGIN=http://localhost:5173
# Dirección pública del front para los enlaces de «crear nueva contraseña» (si no, se usa el origen que los pidió).
# URL_APP=http://localhost:5173
RESEND_API_KEY=
# Opcional: ID de cliente de Google para «Iniciar sesión con Google» en el portal de clientes (docs/google-clientes.md)
GOOGLE_CLIENT_ID=

# ----- Seguridad de acceso (docs/auditoria-seguridad.md). Todo es opcional: estos son los valores por omisión. -----
# Producción: NODE_ENV=production exige un JWT_SECRET de al menos 32 caracteres, CORS_ORIGIN y TRUST_PROXY.
# NODE_ENV=production
# Detrás de un proxy (Nginx, etc.): cuántos proxies hay. Sin esto, los bloqueos y límites por IP verían la IP del proxy.
# TRUST_PROXY=1
# Minutos sin actividad tras los que se cierra la sesión del personal (0 = sin límite) y el de la pantalla de Cocina.
# INACTIVIDAD_MINUTOS=15
# INACTIVIDAD_MINUTOS_COCINA=480
# Minutos de bloqueo tras 5 intentos fallidos de inicio de sesión.
# ACCESO_BLOQUEO_MINUTOS=5
# Límites de peticiones por IP: generales por minuto, y fallos de inicio de sesión/registro cada 15 minutos.
# RATE_LIMIT_POR_MINUTO=1500
# RATE_LIMIT_ACCESO=40
