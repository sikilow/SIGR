# Desarrollo y build contra la API real (modo "api"). Sin datos simulados ni franja "Modo demo".
# En desarrollo, Vite reenvía /api al backend local.
# Si hace falta otra URL de la API, define VITE_API_URL en .env.api.local (no se versiona).
VITE_API_URL=/api
VITE_USE_MOCK=false
API_PROXY_TARGET=http://localhost:3000
