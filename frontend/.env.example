# Copia este archivo a .env.local y ajusta los valores.

# URL base de la API. Puede ser relativa (usa el proxy de Vite) o absoluta.
VITE_API_URL=/api

# true (por defecto) = datos simulados con franja "Modo demo"; false = API real.
# `npm run build:api` fuerza false (ver .env.api).
VITE_USE_MOCK=true

# Intervalo (ms) de actualización automática (panel, cuenta y Mis pedidos). Mínimo 1000.
VITE_POLL_MS=10000

# Solo para el proxy de desarrollo (no llega al navegador).
# Si se define, Vite redirige VITE_API_URL (p. ej. /api) hacia este destino.
# API_PROXY_TARGET=http://localhost:8000
