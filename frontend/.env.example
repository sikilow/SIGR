# Copia este archivo a .env.local y ajusta los valores.

# URL base de la API. Con el backend de este repo: http://localhost:3000/api
# (también puede ser relativa, p. ej. /api, si usas el proxy de Vite).
VITE_API_URL=http://localhost:3000/api

# true (por defecto) = datos simulados en memoria; false = API real (backend/).
VITE_USE_MOCK=true

# Intervalo (ms) de actualización automática del Panel de mesas. Mínimo 1000.
VITE_POLL_MS=10000

# Solo para el proxy de desarrollo (no llega al navegador).
# Si se define, Vite redirige VITE_API_URL (p. ej. /api) hacia este destino.
# API_PROXY_TARGET=http://localhost:8000
